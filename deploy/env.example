# Copy to /etc/sms-receiver/env, fill in the token, then chmod 600.
WEBHOOK_TOKEN=replace-with-output-of-openssl-rand-hex-32
LISTEN_ADDR=127.0.0.1:8044
DB_PATH=/var/lib/sms-receiver/sms.db
LOG_LEVEL=info
TZ=Asia/Shanghai

# Optional: verify SmsForwarder's HMAC sign. Must match the app's secret.
# SMSF_SECRET=
# SMSF_SIGN_SKEW=1h

# Set to true only when the server is behind a trusted reverse proxy.
# TRUST_PROXY=false
